pageType: content
background:
  type: solid
  color: "$base"
notes: 工程 30 秒：重点讲"AI 会失败，但演示不会"——空输入有提示、超时有兜底、降级有标识、注入有防护、密钥不出后端。
elements:
  - elementId: kicker
    elementType: text
    bounds: [70, 44, 220, 18]
    content:
      style: "$kicker"
      wrap: false
      align: [left, middle]
      text: 05 · 工程
  - elementId: title
    elementType: text
    bounds: [68, 72, 620, 44]
    content:
      fontSize: 30
      bold: true
      color: "$ink"
      wrap: false
      align: [left, middle]
      text: AI 会失败，但演示不会
  - elementId: c1-icon
    elementType: icon
    bounds: [70, 138, 16, 16]
    iconName: "fas:circle-check"
    fill: {type: solid, color: "$brass"}
  - elementId: c1-text
    elementType: text
    bounds: [98, 132, 500, 40]
    content:
      fontSize: 13
      color: "$ink"
      lineHeight: 1.45
      align: [left, middle]
