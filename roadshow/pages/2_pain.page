      text: |
        <p>"离职后 3 年内不得入职竞争单位，</p>
        <p>违约金 50 万元。"</p>
  - elementId: q2-src
    elementType: text
    bounds: [558, 268, 336, 16]
    content:
      style: "$small"
      wrap: false
      align: [left, middle]
